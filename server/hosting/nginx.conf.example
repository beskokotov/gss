# Adjust document root, PHP-FPM socket and TLS certificate paths on your server.
server {
    listen 80;
    server_name gss.ru www.gss.ru;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://gss.ru$request_uri; }
}

server {
    listen 443 ssl;
    server_name gss.ru www.gss.ru;
    ssl_certificate /etc/letsencrypt/live/gss.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gss.ru/privkey.pem;
    root /var/www/gss/public;
    index index.html;
    autoindex off;
    client_max_body_size 16k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css text/javascript application/javascript image/svg+xml;

    location = /api/request.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 45s;
        gzip off;
    }
    location ~ \.php(?:/|$) { return 404; }
    location ~ /\. { deny all; }
    location ~* -[A-Za-z0-9_-]{8}\.(js|css)$ { expires 1y; try_files $uri =404; }
    location ~* \.(webp|png|woff2)$ { expires 1d; try_files $uri =404; }
    location ~* \.html$ { expires -1; try_files $uri =404; }
    location / { try_files $uri $uri/ =404; }
}
